# App Configuration
VITE_APP_URL=http://localhost:5173
VITE_ENV_MODE=development

# Supabase Configuration
# The Supabase project URL (e.g., https://xyz.supabase.co)
VITE_SUPABASE_URL=your-supabase-url-here
# The Supabase publishable key for hosted projects (preferred)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
# Quickstart-compatible alias used in some Supabase Vite examples
# VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-publishable-default-key-here
# Optional local/self-hosted fallback when only an anon key is available
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Optional: used by `npm run supabase:types` once a live project exists
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id

# Cloudflare Configuration (if needed for functions later)
# CLOUDFLARE_ACCOUNT_ID=...
